# Zino's own polling settings
[polling]
# Path to a pollfile, the list of routers to monitor and related configuration, shared with Zino
# default "polldevs.cf"
file = "polldevs.cf"
# How often the pollfile is checked for changes, in minutes
# default 1 min
period = 1

[snmp]
# Zino supports two SNMP backends: "netsnmp" and "pysnmp".  The default is "netsnmp" (which requires the Net-SNMP C
# library to be installed on your system).  "pysnmp" selects the pure Python library PySNMP, which is less performant.
backend = "netsnmp"

[scheduler]
# How late a poll may fire before it is skipped instead, in seconds
# default 10 s
misfire_grace_time = 10

[logs]
# Where the event log, the version baselines and the uptimes live
directory = "ver-watch/logs"

[detection]
# How far, in centiseconds, a device's uptime may lag behind the estimate
# before vwatcher calls it a restart
# default 5 minutes
allowed_offset = 30000

[mail]
# Who the daily report comes from and goes to.
# No recipient means nothing is sent
sender = "vwatcher@example.org"
recipient = ""
sendmail = "/usr/sbin/sendmail"
